# ==========================================
# NOXRIDGE UNIVERSAL BACKEND
# NOXRIDGE COMMUNITY
# ==========================================

# APPLICATION
NODE_ENV=production
PORT=3000

# CORS
# Isi dengan origin frontend jika diperlukan.
# Contoh: CORS_ORIGIN=https://example.com
# CORS_ORIGIN=

# ==========================================
# AUTHENTICATION
# ==========================================

# Minimal 32 karakter.
# Generate secret sendiri sebelum digunakan.
# API_KEY=

# Minimal 32 karakter.
# Simpan rahasia ini dengan aman.
# MASTER_KEY=

# ==========================================
# BACKBLAZE B2 STORAGE
# S3 COMPATIBLE
# ==========================================

# Contoh format endpoint:
# B2_ENDPOINT=https://s3.region.backblazeb2.com

# Isi sesuai region bucket B2.
# B2_REGION=

# Nama bucket Backblaze B2.
# B2_BUCKET=

# Backblaze B2 Application Key ID.
# B2_KEY_ID=

# Backblaze B2 Application Key.
# B2_APPLICATION_KEY=

# ==========================================
# AI PROVIDER
# OPENAI-COMPATIBLE API
# ==========================================

# API key dari provider AI pilihan.
# AI_API_KEY=

# Base URL provider AI.
# AI_BASE_URL=

# Nama model AI.
# AI_MODEL=
