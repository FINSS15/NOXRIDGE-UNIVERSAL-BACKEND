# NOXRIDGE UNIVERSAL BACKEND

NODE_ENV=production
PORT=3000
# CORS_ORIGIN=https://your-frontend.example

# Shared backend keys (minimum 32 characters)
# API_KEY=
# MASTER_KEY=

# Account system (PostgreSQL)
# Leave DATABASE_URL unset to keep account routes disabled (503).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Generate a unique random secret of at least 32 characters.
# KEY_ENCRYPTION_SECRET=
# Trial duration in hours; default 24. Change to your policy.
TRIAL_DURATION_HOURS=24

# Backblaze B2
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_BUCKET=
# B2_KEY_ID=
# B2_APPLICATION_KEY=

# Gemini AI (Free Tier only; backend-owned key, never supplied by importer users)
# GEMINI_API_KEY=
# AI chat is fixed to gemini-3.1-flash-lite; no paid-provider fallback.
